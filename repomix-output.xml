/// Tipos de acción que el agente Zen puede solicitar ejecutar.
enum ZenActionType {
  /// Crear una nueva transacción financiera.
  createTransaction,

  /// Completar un hábito existente.
  completeHabit,

  /// Crear una tarea nueva.
  createTask,

  /// Crear un recordatorio (Apple Reminders / Calendar).
  createReminder,

  /// Guardar una reflexión en la bóveda de Obsidian.
  saveReflection,

  /// Consulta informativa — sin acción en datos.
  query,

  /// Acción desconocida / no mapeada.
  unknown,
}

/// Parseador de strings provenientes del JSON del agente.
extension ZenActionTypeParser on ZenActionType {
  static ZenActionType fromString(String? raw) {
    switch (raw) {
      case 'create_transaction':
        return ZenActionType.createTransaction;
      case 'complete_habit':
        return ZenActionType.completeHabit;
      case 'create_task':
        return ZenActionType.createTask;
      case 'create_reminder':
        return ZenActionType.createReminder;
      case 'save_reflection':
        return ZenActionType.saveReflection;
      case 'query':
        return ZenActionType.query;
      default:
        return ZenActionType.unknown;
    }
  }

  String toSnakeCase() {
    switch (this) {
      case ZenActionType.createTransaction:
        return 'create_transaction';
      case ZenActionType.completeHabit:
        return 'complete_habit';
      case ZenActionType.createTask:
        return 'create_task';
      case ZenActionType.createReminder:
        return 'create_reminder';
      case ZenActionType.saveReflection:
        return 'save_reflection';
      case ZenActionType.query:
        return 'query';
      case ZenActionType.unknown:
        return 'unknown';
    }
  }
}

/// Respuesta estructurada del agente conversacional OpenCode Zen.
///
/// El agente siempre responde con un JSON de esta forma:
/// ```json
/// {
///   "action": "create_transaction",
///   "data": { "amount": 50, "category": "Comida", "note": "Almuerzo" },
///   "message": "Entendido, registré tu gasto de $50 en Comida."
/// }
/// ```
class ZenResponse {
  /// Acción que el agente solicita ejecutar.
  final ZenActionType action;

  /// Datos estructurados asociados a la acción (puede ser vacío).
  final Map<String, dynamic> data;

  /// Mensaje en lenguaje natural para mostrar al usuario.
  final String message;

  const ZenResponse({
    required this.action,
    required this.data,
    required this.message,
  });

  factory ZenResponse.fromJson(Map<String, dynamic> json) {
    return ZenResponse(
      action: ZenActionTypeParser.fromString(json['action'] as String?),
      data: (json['data'] as Map<String, dynamic>?) ?? {},
      message: (json['message'] as String?) ?? '',
    );
  }

  Map<String, dynamic> toJson() => {
    'action': action.toSnakeCase(),
    'data': data,
    'message': message,
  };

  /// Crea una respuesta de error formateada para mostrar al usuario.
  factory ZenResponse.error(String errorMessage) {
    return ZenResponse(
      action: ZenActionType.unknown,
      data: const {},
      message: errorMessage,
    );
  }

  @override
  String toString() =>
      'ZenResponse(action: ${action.toSnakeCase()}, message: $message, data: $data)';
}
