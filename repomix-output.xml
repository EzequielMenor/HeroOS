<file path="lib/data/services/apple_connector_service.dart">
import 'dart:convert';

import 'package:http/http.dart' as http;
import 'package:url_launcher/url_launcher.dart';

import '../../core/constants/supabase_config.dart';
import '../models/apple_event_model.dart';
import '../models/apple_reminder_model.dart';

/// Nombre del Shortcut de Apple configurado por el usuario para recordatorios.
///
/// El usuario debe crear un Shortcut con este nombre exacto que acepte texto
/// JSON como input y llame a "Agregar nuevo recordatorio".
const String _kReminderShortcutName = 'CreateHeroOSReminder';

/// Nombre del Shortcut de Apple configurado por el usuario para eventos.
const String _kEventShortcutName = 'CreateHeroOSEvent';

/// Servicio de integración con el ecosistema Apple (Reminders + Calendar).
///
/// ## Estrategia de implementación
///
/// Se usa la **Opción B (API REST + Shortcuts)** decidida en el diseño técnico:
///
/// 1. **Cuando la app está abierta** → `url_launcher` abre un Shortcut de Apple
///    vía URL scheme `shortcuts://run-shortcut?name=<name>&input=<json>`.
///    El Shortcut del usuario recibe el JSON y crea el reminder/event nativo.
///
/// 2. **Cuando la app está cerrada (24/7)** → la Edge Function de Supabase
///    recibe el pedido vía HTTP y llama al mismo Shortcut via la API de
///    Shortcuts (o activa el Shortcut via webhook configurado por el usuario).
///
/// ## Configuración requerida por el usuario
///
/// El usuario debe crear en la app Shortcuts estos automatismos:
/// - **"CreateHeroOSReminder"**: Recibe texto JSON → "Agregar recordatorio"
/// - **"CreateHeroOSEvent"**: Recibe texto JSON → "Agregar evento al calendario"
///
/// Esto es un one-time setup; después la integración funciona automáticamente.
class AppleConnectorService {
  final http.Client _httpClient;

  AppleConnectorService({http.Client? httpClient})
    : _httpClient = httpClient ?? http.Client();

  // ── Recordatorios ─────────────────────────────────────────────────────────

  /// Crea un recordatorio en Apple Reminders via Shortcuts URL scheme.
  ///
  /// Abre la app Shortcuts con el JSON del recordatorio como input.
  /// El Shortcut "CreateHeroOSReminder" del usuario procesa el JSON.
  ///
  /// Lanza [Exception] si el dispositivo no soporta el URL scheme de Shortcuts
  /// (e.g. Android o iOS sin la app Shortcuts).
  Future<void> createReminder(AppleReminderModel reminder) async {
    final json = jsonEncode(reminder.toJson());
    await _launchShortcut(
      shortcutName: _kReminderShortcutName,
      inputJson: json,
    );
  }

  // ── Eventos de calendario ─────────────────────────────────────────────────

  /// Crea un evento en Apple Calendar via Shortcuts URL scheme.
  ///
  /// Lanza [Exception] si el end date es anterior al start date.
  Future<void> createCalendarEvent(AppleEventModel event) async {
    if (event.endDate.isBefore(event.startDate)) {
      throw ArgumentError(
        'AppleConnectorService: endDate debe ser posterior a startDate.',
      );
    }

    final json = jsonEncode(event.toJson());
    await _launchShortcut(shortcutName: _kEventShortcutName, inputJson: json);
  }

  // ── Edge Function API (para acceso 24/7 desde Telegram/external) ──────────

  /// Crea un recordatorio via la Edge Function de Supabase.
  ///
  /// Útil cuando la app no está abierta y el comando llega desde el agente
  /// Telegram o cualquier cliente externo. La Edge Function llama al Shortcut
  /// del usuario via la API de Shortcuts (si está configurado).
  ///
  /// Requiere que [Secrets.supabaseAnonKey] y la URL base estén configurados.
  ///
  /// Lanza [Exception] si la Edge Function retorna un status != 200.
  Future<void> createReminderViaApi(AppleReminderModel reminder) async {
    await _callEdgeFunction(
      functionName: 'apple-create-reminder',
      body: reminder.toJson(),
    );
  }

  /// Crea un evento de calendario via la Edge Function de Supabase.
  Future<void> createCalendarEventViaApi(AppleEventModel event) async {
    if (event.endDate.isBefore(event.startDate)) {
      throw ArgumentError(
        'AppleConnectorService: endDate debe ser posterior a startDate.',
      );
    }

    await _callEdgeFunction(
      functionName: 'apple-create-event',
      body: event.toJson(),
    );
  }

  // ── Private helpers ───────────────────────────────────────────────────────

  /// Construye y lanza la URL de Shortcuts.
  ///
  /// Formato: `shortcuts://run-shortcut?name=<name>&input=text&text=<json>`
  Future<void> _launchShortcut({
    required String shortcutName,
    required String inputJson,
  }) async {
    final encodedName = Uri.encodeComponent(shortcutName);
    final encodedInput = Uri.encodeComponent(inputJson);
    final uri = Uri.parse(
      'shortcuts://run-shortcut?name=$encodedName&input=text&text=$encodedInput',
    );

    final canLaunch = await canLaunchUrl(uri);
    if (!canLaunch) {
      throw Exception(
        'AppleConnectorService: No se puede abrir Shortcuts. '
        '¿La app Shortcuts está instalada? URI: $uri',
      );
    }

    await launchUrl(uri);
  }

  /// Llama a una Edge Function de Supabase con el [body] dado.
  Future<void> _callEdgeFunction({
    required String functionName,
    required Map<String, dynamic> body,
  }) async {
    final supabaseUrl = SupabaseConfig.url;
    final anonKey = SupabaseConfig.anonKey;

    if (supabaseUrl.isEmpty || anonKey.isEmpty) {
      throw Exception(
        'AppleConnectorService: supabaseUrl o supabaseAnonKey no configurados.',
      );
    }

    final url = Uri.parse('$supabaseUrl/functions/v1/$functionName');

    final response = await _httpClient
        .post(
          url,
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer $anonKey',
          },
          body: jsonEncode(body),
        )
        .timeout(const Duration(seconds: 15));

    if (response.statusCode != 200) {
      throw Exception(
        'AppleConnectorService [$functionName]: '
        'Error ${response.statusCode} — ${response.body}',
      );
    }
  }
}
