import 'dart:convert';

import 'package:http/http.dart' as http;

import '../../core/config/secrets.dart';
import '../../domain/entities/profile_entity.dart';
import '../models/zen_response.dart';

/// Contexto del usuario que el agente necesita para personalizar sus respuestas.
///
/// Se construye desde el [ProfileEntity] activo y datos opcionales adicionales.
class UserContext {
  /// Nombre del héroe (para personalizar el saludo).
  final String heroName;

  /// Nivel actual del héroe.
  final int level;

  /// HP actual vs máximo (ej. "80/100").
  final String hpStatus;

  /// Oro (balance financiero actual).
  final double currentGold;

  /// Hábitos activos del día (nombres para contexto del agente).
  final List<String> activeHabits;

  /// Tareas pendientes del día (títulos para contexto del agente).
  final List<String> pendingTasks;

  const UserContext({
    required this.heroName,
    required this.level,
    required this.hpStatus,
    required this.currentGold,
    this.activeHabits = const [],
    this.pendingTasks = const [],
  });

  /// Construye un [UserContext] desde un [ProfileEntity].
  factory UserContext.fromProfile(
    ProfileEntity profile, {
    List<String> activeHabits = const [],
    List<String> pendingTasks = const [],
  }) {
    return UserContext(
      heroName: profile.username,
      level: profile.level,
      hpStatus: '${profile.currentHp}/${profile.maxHp}',
      currentGold: profile.currentGold,
      activeHabits: activeHabits,
      pendingTasks: pendingTasks,
    );
  }

  /// Serializa el contexto para incluirlo en el system prompt del agente.
  String toPromptString() {
    final buffer = StringBuffer();
    buffer.writeln('Estado actual del héroe:');
    buffer.writeln('- Nombre: $heroName');
    buffer.writeln('- Nivel: $level');
    buffer.writeln('- HP: $hpStatus');
    buffer.writeln('- Oro (balance): \$${currentGold.toStringAsFixed(2)}');
    if (activeHabits.isNotEmpty) {
      buffer.writeln('- Hábitos de hoy: ${activeHabits.join(', ')}');
    }
    if (pendingTasks.isNotEmpty) {
      buffer.writeln('- Tareas pendientes: ${pendingTasks.join(', ')}');
    }
    return buffer.toString();
  }
}

/// Servicio principal para el agente conversacional de HeroOS via OpenCode Zen.
///
/// Responsabilidades:
/// - Enviar mensajes del usuario al agente con el contexto RPG de HeroOS.
/// - Parsear las respuestas JSON estructuradas del agente a [ZenResponse].
/// - Ser inyectable via Provider en el árbol de widgets.
///
/// Uso:
/// ```dart
/// final service = ZenCoreService();
/// final response = await service.chat('Registré un gasto de 50 en comida', context);
/// ```
class ZenCoreService {
  static const String _endpoint = 'https://opencode.ai/zen/v1/chat/completions';
  static const String _model = 'claude-sonnet-4-5';

  static const String _systemPrompt = '''
Eres el asistente inteligente de HeroOS, una app de vida gamificada estilo RPG.
Tu nombre es Zen y tu misión es ayudar al usuario a gestionar sus finanzas, hábitos y tareas mediante lenguaje natural.

SIEMPRE responde con un JSON válido con esta estructura exacta:
{
  "action": "<tipo_de_accion>",
  "data": { <datos_estructurados_si_aplica> },
  "message": "<mensaje_motivador_en_español>"
}

Tipos de acción disponibles:
- "create_transaction": Registrar un ingreso o gasto. Data: { "amount": number, "category": string, "note": string, "type": "income"|"expense" }
- "complete_habit": Marcar un hábito como completado. Data: { "habit_name": string }
- "create_task": Crear una nueva tarea. Data: { "title": string, "difficulty": 1|2|3 }
- "create_reminder": Crear un recordatorio. Data: { "title": string, "date": "ISO8601", "notes": string }
- "save_reflection": Guardar una reflexión en Obsidian. Data: { "title": string, "content": string }
- "query": Responder una pregunta informativa. Data: {}

Reglas:
1. Detecta la intención del mensaje y elige la acción más adecuada.
2. Si el usuario menciona un monto (ej. "\$50", "50 pesos", "cincuenta"), extráelo como number en "amount".
3. Si el usuario dice "hice ejercicio", "completé mi hábito de...", usa "complete_habit".
4. El campo "message" debe ser motivador, usar el nombre del héroe y referencias RPG cuando aplique (XP, nivel, HP).
5. Si no entiendes la intención, usa "query" y pide clarificación en "message".
6. No inventes datos — si faltan datos críticos (ej. monto de una transacción), usa "query" y pide el dato faltante.
''';

  /// Envía un mensaje al agente con el contexto del usuario y retorna la respuesta parseada.
  ///
  /// Lanza [Exception] si la API falla o la respuesta no es JSON válido.
  Future<ZenResponse> chat(String message, UserContext context) async {
    final apiKey = Secrets.opencodeZenApiKey;
    if (apiKey.isEmpty) {
      return ZenResponse.error(
        'La API key de OpenCode Zen no está configurada. '
        'Añade OPENCODE_ZEN_API_KEY en secrets.dart.',
      );
    }

    final contextualSystem = '$_systemPrompt\n\n${context.toPromptString()}';

    final response = await http
        .post(
          Uri.parse(_endpoint),
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer $apiKey',
          },
          body: jsonEncode({
            'model': _model,
            'messages': [
              {'role': 'system', 'content': contextualSystem},
              {'role': 'user', 'content': message},
            ],
            'response_format': {'type': 'json_object'},
            'max_tokens': 800,
            'temperature': 0.4,
          }),
        )
        .timeout(const Duration(seconds: 30));

    if (response.statusCode != 200) {
      throw Exception(
        'ZenCoreService: Error ${response.statusCode} — ${response.body}',
      );
    }

    final data = jsonDecode(response.body) as Map<String, dynamic>;
    final content =
        data['choices']?[0]?['message']?['content'] as String? ?? '';
    if (content.isEmpty) {
      throw Exception('ZenCoreService: Respuesta vacía del agente');
    }

    final jsonResponse = jsonDecode(content) as Map<String, dynamic>;
    return ZenResponse.fromJson(jsonResponse);
  }
}
