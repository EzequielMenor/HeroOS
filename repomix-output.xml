<file path="lib/data/models/apple_event_model.dart">
/// Modelo de datos para un evento de Apple Calendar.
///
/// Se serializa a JSON para ser enviado como input a un Shortcut de Apple
/// o como payload a la Edge Function de Supabase.
///
/// Ejemplo de JSON generado:
/// ```json
/// {
///   "title": "Revisión semanal HeroOS",
///   "start_date": "2026-04-14T10:00:00.000",
///   "end_date": "2026-04-14T10:30:00.000",
///   "location": "Casa",
///   "notes": "Revisar hábitos, finanzas y tareas de la semana.",
///   "calendar": "HeroOS"
/// }
/// ```
class AppleEventModel {
  /// Título del evento.
  final String title;

  /// Fecha y hora de inicio del evento.
  final DateTime startDate;

  /// Fecha y hora de fin del evento.
  final DateTime endDate;

  /// Ubicación del evento (opcional).
  final String? location;

  /// Notas adicionales del evento (opcional).
  final String? notes;

  /// Calendario donde se creará el evento (default: "HeroOS").
  final String calendar;

  const AppleEventModel({
    required this.title,
    required this.startDate,
    required this.endDate,
    this.location,
    this.notes,
    this.calendar = 'HeroOS',
  }) : assert(
         true, // endDate > startDate se valida en el factory/repository
       );

  factory AppleEventModel.fromJson(Map<String, dynamic> json) {
    return AppleEventModel(
      title: json['title'] as String,
      startDate: DateTime.parse(json['start_date'] as String),
      endDate: DateTime.parse(json['end_date'] as String),
      location: json['location'] as String?,
      notes: json['notes'] as String?,
      calendar: (json['calendar'] as String?) ?? 'HeroOS',
    );
  }

  Map<String, dynamic> toJson() => {
    'title': title,
    'start_date': startDate.toIso8601String(),
    'end_date': endDate.toIso8601String(),
    if (location != null) 'location': location,
    if (notes != null) 'notes': notes,
    'calendar': calendar,
  };

  /// Duración del evento.
  Duration get duration => endDate.difference(startDate);

  @override
  String toString() =>
      'AppleEventModel(title: $title, start: $startDate, end: $endDate)';
}
</file>

<file path="lib/data/models/apple_reminder_model.dart">
/// Modelo de datos para un recordatorio de Apple Reminders.
///
/// Se serializa a JSON para ser enviado como input a un Shortcut de Apple
/// o como payload a la Edge Function de Supabase.
///
/// Ejemplo de JSON generado:
/// ```json
/// {
///   "title": "Completar hábito: Meditación",
///   "due_date": "2026-04-12T20:00:00.000",
///   "notes": "Recuerda: 10 minutos antes de dormir. +10 XP al completar.",
///   "list": "HeroOS"
/// }
/// ```
class AppleReminderModel {
  /// Título del recordatorio (máx. recomendado: 255 caracteres).
  final String title;

  /// Fecha y hora límite del recordatorio (null = sin vencimiento).
  final DateTime? dueDate;

  /// Notas adicionales del recordatorio.
  final String? notes;

  /// Lista de Reminders donde se creará (default: "HeroOS").
  final String list;

  const AppleReminderModel({
    required this.title,
    this.dueDate,
    this.notes,
    this.list = 'HeroOS',
  });

  factory AppleReminderModel.fromJson(Map<String, dynamic> json) {
    return AppleReminderModel(
      title: json['title'] as String,
      dueDate: json['due_date'] != null
          ? DateTime.parse(json['due_date'] as String)
          : null,
      notes: json['notes'] as String?,
      list: (json['list'] as String?) ?? 'HeroOS',
    );
  }

  Map<String, dynamic> toJson() => {
    'title': title,
    if (dueDate != null) 'due_date': dueDate!.toIso8601String(),
    if (notes != null) 'notes': notes,
    'list': list,
  };

  /// Serializa el modelo como texto URL-encoded para el input de un Shortcut.
  ///
  /// Apple Shortcuts acepta texto como input; se usa JSON serializado.
  String toShortcutInput() => toJson().entries
      .map((e) => '${e.key}=${Uri.encodeComponent(e.value.toString())}')
      .join('&');

  @override
  String toString() =>
      'AppleReminderModel(title: $title, dueDate: $dueDate, list: $list)';
}
