<file path="lib/data/models/detected_intent_model.dart">
/// Tipos de intents que el parser puede detectar en texto libre.
enum IntentType {
  /// Gasto: "gasté \$50 en comida", "pagué 200 de alquiler"
  financeExpense,

  /// Ingreso: "gané \$1500 de nómina", "cobré 300"
  financeIncome,

  /// Completar hábito: "completé ejercicio", "hice meditación hoy"
  habitComplete,

  /// Crear tarea: "necesito hacer", "tengo que completar"
  taskCreate,

  /// No se detectó ningún intent reconocido.
  unknown,
}

/// Parseador de strings para IntentType.
extension IntentTypeParser on IntentType {
  static IntentType fromString(String? raw) {
    switch (raw) {
      case 'finance_expense':
        return IntentType.financeExpense;
      case 'finance_income':
        return IntentType.financeIncome;
      case 'habit_complete':
        return IntentType.habitComplete;
      case 'task_create':
        return IntentType.taskCreate;
      default:
        return IntentType.unknown;
    }
  }

  String toSnakeCase() {
    switch (this) {
      case IntentType.financeExpense:
        return 'finance_expense';
      case IntentType.financeIncome:
        return 'finance_income';
      case IntentType.habitComplete:
        return 'habit_complete';
      case IntentType.taskCreate:
        return 'task_create';
      case IntentType.unknown:
        return 'unknown';
    }
  }
}

/// Resultado del análisis de un mensaje por el [AgentParserService].
///
/// Contiene el intent detectado, los datos extraídos y un score de confianza
/// entre 0.0 (ninguna confianza) y 1.0 (certeza total).
class DetectedIntentModel {
  /// Tipo de intent detectado en el texto.
  final IntentType intentType;

  /// Confianza en la detección (0.0 – 1.0).
  /// < 0.5 → dudoso, se recomienda LLM fallback.
  final double confidence;

  /// Datos estructurados extraídos del mensaje.
  ///
  /// Según [intentType]:
  /// - finance_expense / finance_income: { "amount": double, "category": string, "note": string }
  /// - habit_complete: { "habit_name": string }
  /// - task_create:    { "title": string }
  final Map<String, dynamic> extractedData;

  /// Fragmento del mensaje original que disparó la detección.
  final String matchedText;

  const DetectedIntentModel({
    required this.intentType,
    required this.confidence,
    this.extractedData = const {},
    this.matchedText = '',
  });

  /// Crea un intent desconocido (sin coincidencia).
  factory DetectedIntentModel.unknown() {
    return const DetectedIntentModel(
      intentType: IntentType.unknown,
      confidence: 0.0,
    );
  }

  /// ¿El intent tiene suficiente confianza para ejecutarse sin LLM?
  bool get isConfident => confidence >= 0.7;

  /// Serialización para logging/debugging.
  Map<String, dynamic> toJson() => {
    'intent_type': intentType.toSnakeCase(),
    'confidence': confidence,
    'extracted_data': extractedData,
    'matched_text': matchedText,
  };

  @override
  String toString() =>
      'DetectedIntent(${intentType.toSnakeCase()}, confidence: $confidence, data: $extractedData)';
}
