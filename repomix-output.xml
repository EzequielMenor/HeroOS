import '../../data/models/detected_intent_model.dart';
import '../../data/models/zen_response.dart';
import '../../data/services/zen_core_service.dart';
import 'agent_parser_service.dart';

/// Resultado del routing de un comando.
sealed class RoutingResult {
  const RoutingResult();
}

/// El mensaje fue manejado por un comando built-in (regex match directo).
final class BuiltinResult extends RoutingResult {
  /// Intent que se ejecutó.
  final DetectedIntentModel intent;

  /// Resultado de la ejecución (puede ser nulo si no se ejecutó aún).
  final Object? payload;

  /// Mensaje de feedback RPG para el usuario.
  final String message;

  const BuiltinResult({
    required this.intent,
    required this.message,
    this.payload,
  });
}

/// El mensaje requiere LLM (texto libre no reconocido por regex).
final class LlmFallbackResult extends RoutingResult {
  /// Respuesta del agente LLM.
  final ZenResponse zenResponse;

  const LlmFallbackResult({required this.zenResponse});
}

/// El routing encontró un error (repositorio, red, etc.).
final class ErrorResult extends RoutingResult {
  final String message;
  final Object? error;

  const ErrorResult({required this.message, this.error});
}

/// Tool Routing Engine de HeroOS.
///
/// Decide la ruta de ejecución para cada mensaje del usuario:
///
/// ```
/// mensaje → [AgentParserService] → ¿confidence >= 0.70?
///                ├── SÍ  → ejecutar built-in (sin LLM)
///                └── NO  → [ZenCoreService] (LLM fallback)
/// ```
///
/// Uso:
/// ```dart
/// final router = ToolRouterService(
///   parserService: myParser,
///   zenService: myZen,
/// );
/// final result = await router.route('gasté \$50 en comida', context: userCtx, userId: uid);
/// ```
class ToolRouterService {
  final AgentParserService _parser;
  final ZenCoreService _zen;

  ToolRouterService({
    required AgentParserService parserService,
    required ZenCoreService zenService,
  }) : _parser = parserService,
       _zen = zenService;

  // ─── API pública ──────────────────────────────────────────────────────────

  /// Analiza [message] y decide la ruta de ejecución.
  ///
  /// Si el parser detecta un intent con confianza suficiente, ejecuta el
  /// comando built-in via [executeBuiltin].
  ///
  /// Si la confianza es baja, deriva al LLM ([ZenCoreService]).
  ///
  /// [userId] y [accountId] son necesarios para ejecutar transacciones
  /// financieras directamente. Si son nulos, se retorna un [LlmFallbackResult].
  Future<RoutingResult> route(
    String message, {
    required UserContext context,
    String? userId,
    String? accountId,
  }) async {
    try {
      final intents = _parser.detectIntents(message);
      final best = intents.first;

      if (best.isConfident && best.intentType != IntentType.unknown) {
        return executeBuiltin(best, userId: userId, accountId: accountId);
      }

      // Fallback al LLM
      final zenResponse = await _zen.chat(message, context);
      return LlmFallbackResult(zenResponse: zenResponse);
    } catch (e) {
      return ErrorResult(
        message: 'Error al procesar el mensaje: ${e.toString()}',
        error: e,
      );
    }
  }

  /// Ejecuta directamente un [ParsedCommand] built-in sin pasar por LLM.
  ///
  /// Retorna [BuiltinResult] con el feedback RPG o [ErrorResult] si falla.
  Future<RoutingResult> executeBuiltin(
    DetectedIntentModel intent, {
    String? userId,
    String? accountId,
  }) async {
    try {
      switch (intent.intentType) {
        case IntentType.financeExpense:
          return await _handleFinance(
            intent,
            userId: userId,
            accountId: accountId,
          );

        case IntentType.financeIncome:
          return await _handleFinance(
            intent,
            userId: userId,
            accountId: accountId,
          );

        case IntentType.habitComplete:
          return await _handleHabit(intent);

        case IntentType.taskCreate:
          return _handleTask(intent);

        case IntentType.unknown:
          return ErrorResult(
            message: 'Intent desconocido — no se puede ejecutar como built-in.',
          );
      }
    } catch (e) {
      return ErrorResult(
        message: 'Error ejecutando comando built-in: ${e.toString()}',
        error: e,
      );
    }
  }

  // ─── Handlers privados ────────────────────────────────────────────────────

  Future<RoutingResult> _handleFinance(
    DetectedIntentModel intent, {
    String? userId,
    String? accountId,
  }) async {
    if (userId == null || accountId == null) {
      return ErrorResult(
        message:
            'Se necesita userId y accountId para registrar una transacción. '
            'Asegurate de estar autenticado.',
      );
    }

    await _parser.executeFinanceIntent(
      intent,
      userId: userId,
      accountId: accountId,
    );

    final isExpense = intent.intentType == IntentType.financeExpense;
    final amount = intent.extractedData['amount'] as double? ?? 0.0;
    final category = intent.extractedData['category'] as String? ?? 'General';

    final emoji = isExpense ? '⚔️' : '✨';
    final verb = isExpense ? 'Gasto registrado' : 'Ingreso registrado';
    final goldOp = isExpense ? 'perdiste' : 'ganaste';

    return BuiltinResult(
      intent: intent,
      payload: intent.extractedData,
      message:
          '$emoji $verb: \$${amount.toStringAsFixed(2)} en $category. '
          '¡$goldOp oro del inventario, héroe!',
    );
  }

  Future<RoutingResult> _handleHabit(DetectedIntentModel intent) async {
    final habit = await _parser.executeHabitIntent(intent);

    if (habit == null) {
      final name = intent.extractedData['habit_name'] as String? ?? '';
      return ErrorResult(
        message:
            '🔍 No encontré ningún hábito activo llamado "$name". '
            'Revisá tus hábitos en la sección de Quests.',
      );
    }

    return BuiltinResult(
      intent: intent,
      payload: habit,
      message:
          '🏆 ¡Hábito "${habit.title}" completado! '
          '+${habit.xpReward} XP ganados. ¡Seguí así, héroe!',
    );
  }

  RoutingResult _handleTask(DetectedIntentModel intent) {
    final title = intent.extractedData['title'] as String? ?? '';
    // La creación real de la tarea la maneja el ViewModel;
    // aquí sólo confirmamos el routing y devolvemos los datos estructurados.
    return BuiltinResult(
      intent: intent,
      payload: intent.extractedData,
      message:
          '📋 Tarea registrada: "$title". '
          '¡Completala para ganar XP, héroe!',
    );
  }
}
