/// Contrato del repositorio de Obsidian.
///
/// Define las operaciones de escritura en la bóveda de Obsidian del usuario.
/// La implementación concreta en [data/repositories/obsidian_repository.dart]
/// delega en [ObsidianService] para el acceso al sistema de archivos.
abstract interface class IObsidianRepository {
  /// Lanza el selector de carpeta para que el usuario configure su bóveda.
  ///
  /// Persiste el path seleccionado en [SharedPreferences].
  /// Lanza [Exception] si el usuario cancela o el path no es válido.
  Future<void> configureVault();

  /// Retorna el path absoluto de la bóveda configurada, o null si no hay ninguna.
  Future<String?> getVaultPath();

  /// Escribe una reflexión personal en `Journal/YYYY-MM-DD-<slug>.md`.
  ///
  /// [title] Título de la reflexión.
  /// [content] Cuerpo en Markdown.
  /// Lanza [Exception] si la bóveda no está configurada o el archivo no se puede crear.
  Future<void> writeReflection(String title, String content);

  /// Escribe un resumen de proyecto en `Projects/<projectName>/<slug>.md`.
  ///
  /// [projectName] Nombre del proyecto (usada como subcarpeta).
  /// [summary] Contenido del resumen en Markdown.
  Future<void> writeProjectSummary(String projectName, String summary);

  /// Escribe una idea rápida en `Ideas/<slug>.md`.
  ///
  /// [title] Título de la idea.
  /// [description] Descripción extendida en Markdown.
  Future<void> writeIdea(String title, String description);
}
