import 'dart:io';

import 'package:file_picker/file_picker.dart';
import 'package:shared_preferences/shared_preferences.dart';

/// Clave usada para persistir el path de la bóveda en SharedPreferences.
const String _kVaultPathKey = 'obsidian_vault_path';

/// Servicio de escritura en la bóveda de Obsidian del usuario.
///
/// Responsabilidades:
/// - Persistir el path de la bóveda elegida por el usuario (una única vez).
/// - Construir y escribir archivos .md con frontmatter YAML en las subcarpetas
///   correctas: Journal/, Projects/, Ideas/.
/// - Ser inyectable vía Provider (instanciable, no static).
///
/// Limitaciones conocidas (iOS):
/// - Flutter corre en sandbox; el usuario debe seleccionar la carpeta de Obsidian
///   explícitamente desde la app de Archivos (iCloud). Una vez concedido el
///   acceso, la escritura es directa y iCloud sincroniza en background.
///
/// Uso:
/// ```dart
/// final service = ObsidianService();
/// await service.configureVault(); // Abre file_picker
/// await service.writeReflection('Mi día', '## Reflexión\n...');
/// ```
class ObsidianService {
  // ── Vault path ──────────────────────────────────────────────────────────────

  /// Lanza el selector nativo de carpetas y persiste el path elegido.
  ///
  /// Lanza [Exception] si el usuario cancela la selección.
  Future<void> configureVault() async {
    final result = await FilePicker.platform.getDirectoryPath(
      dialogTitle: 'Seleccioná tu bóveda de Obsidian',
    );

    if (result == null) {
      throw Exception(
        'ObsidianService: El usuario canceló la selección de bóveda.',
      );
    }

    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kVaultPathKey, result);
  }

  /// Retorna el path absoluto guardado, o [null] si nunca se configuró.
  Future<String?> getVaultPath() async {
    final prefs = await SharedPreferences.getInstance();
    return prefs.getString(_kVaultPathKey);
  }

  // ── Write helpers ────────────────────────────────────────────────────────────

  /// Escribe una reflexión personal en `<vault>/Journal/YYYY-MM-DD-<slug>.md`.
  Future<void> writeReflection(String title, String content) async {
    final now = DateTime.now();
    final datePrefix = '${now.year}-${_pad(now.month)}-${_pad(now.day)}';
    final fileName = '$datePrefix-${_slugify(title)}.md';

    await _writeFile(
      subfolder: 'Journal',
      fileName: fileName,
      title: title,
      body: content,
      tags: ['heroos', 'reflexion', 'ai-generated'],
    );
  }

  /// Escribe un resumen de proyecto en `<vault>/Projects/<projectName>/<slug>.md`.
  Future<void> writeProjectSummary(String projectName, String summary) async {
    final now = DateTime.now();
    final datePrefix = '${now.year}-${_pad(now.month)}-${_pad(now.day)}';
    final fileName = '$datePrefix-summary.md';

    await _writeFile(
      subfolder: 'Projects/${_slugify(projectName)}',
      fileName: fileName,
      title: 'Resumen: $projectName',
      body: summary,
      tags: ['heroos', 'proyecto', 'ai-generated'],
    );
  }

  /// Escribe una idea rápida en `<vault>/Ideas/<slug>.md`.
  Future<void> writeIdea(String title, String description) async {
    final now = DateTime.now();
    final datePrefix = '${now.year}-${_pad(now.month)}-${_pad(now.day)}';
    final fileName = '$datePrefix-${_slugify(title)}.md';

    await _writeFile(
      subfolder: 'Ideas',
      fileName: fileName,
      title: title,
      body: description,
      tags: ['heroos', 'idea', 'ai-generated'],
    );
  }

  // ── Private ──────────────────────────────────────────────────────────────────

  /// Escribe un archivo .md en `<vault>/<subfolder>/<fileName>`.
  ///
  /// Crea las carpetas intermedias si no existen.
  /// Lanza [Exception] si la bóveda no está configurada.
  Future<void> _writeFile({
    required String subfolder,
    required String fileName,
    required String title,
    required String body,
    required List<String> tags,
  }) async {
    final vaultPath = await getVaultPath();
    if (vaultPath == null || vaultPath.isEmpty) {
      throw Exception(
        'ObsidianService: La bóveda no está configurada. '
        'Llamá a configureVault() primero.',
      );
    }

    final dir = Directory('$vaultPath/$subfolder');
    if (!dir.existsSync()) {
      await dir.create(recursive: true);
    }

    final file = File('${dir.path}/$fileName');
    final markdown = _buildMarkdown(title: title, body: body, tags: tags);
    await file.writeAsString(markdown, flush: true);
  }

  /// Construye el contenido Markdown con frontmatter YAML.
  String _buildMarkdown({
    required String title,
    required String body,
    required List<String> tags,
  }) {
    final now = DateTime.now().toIso8601String();
    final tagList = tags.map((t) => '  - $t').join('\n');

    return '''---
created: $now
tags:
$tagList
---

# $title

$body

---
*Generado por HeroOS AI Agent*
''';
  }

  /// Convierte un título a slug válido para nombre de archivo.
  /// Ej. "Mi Reflexión #1" → "mi-reflexion-1"
  String _slugify(String input) {
    return input
        .toLowerCase()
        .replaceAll(RegExp(r'[àáâãäå]'), 'a')
        .replaceAll(RegExp(r'[èéêë]'), 'e')
        .replaceAll(RegExp(r'[ìíîï]'), 'i')
        .replaceAll(RegExp(r'[òóôõö]'), 'o')
        .replaceAll(RegExp(r'[ùúûü]'), 'u')
        .replaceAll(RegExp(r'[ñ]'), 'n')
        .replaceAll(RegExp(r'[^\w\s\-]'), '')
        .trim()
        .replaceAll(RegExp(r'\s+'), '-');
  }

  /// Left-pads un entero con cero para formato de fecha.
  String _pad(int n) => n.toString().padLeft(2, '0');
}
</file>

