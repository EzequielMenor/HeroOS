<file path="lib/domain/services/agent_parser_service.dart">
import '../../data/models/detected_intent_model.dart';
import '../entities/transaction_entity.dart';
import '../entities/habit_entity.dart';
import '../repositories/i_finance_repository.dart';
import '../repositories/i_habit_repository.dart';

// ─── Patrones regex ──────────────────────────────────────────────────────────
//
// NOTA sobre literales de $ en Dart triple-quote:
// El símbolo $ DEBE escaparse como \$ para evitar interpolación no deseada.

/// Detecta gastos: "gasté $50 en comida", "pagué 200 de alquiler", "compré por 30"
final _expenseRegex = RegExp(
  r'(gast[eé]|pagu[eé]|compr[eé]|deb[ií]to?|sali[oó]|cost[oó])'
  r'\s+(?:de\s+)?'
  r'[\$€]?(\d+(?:[.,]\d{1,2})?)'
  r'(?:\s+(?:de|en|para|por)\s+(.+?))?$',
  caseSensitive: false,
  multiLine: true,
);

/// Detecta ingresos: "gané $1500 de nómina", "cobré 300", "recibí $200"
final _incomeRegex = RegExp(
  r'(gan[eé]|cobr[eé]|recib[ií]|ingres[eé]|entr[oó]|deposit[eé])'
  r'\s+(?:de\s+)?'
  r'[\$€]?(\d+(?:[.,]\d{1,2})?)'
  r'(?:\s+(?:de|por|en)\s+(.+?))?$',
  caseSensitive: false,
  multiLine: true,
);

/// Detecta completar hábito: "completé ejercicio", "hice meditación", "terminé correr"
final _habitRegex = RegExp(
  r'(complet[eé]|hic[ei]|termin[eé]|realic[eé]|practiqu[eé]|hice\s+mi\s+h[aá]bito\s+de)'
  r'\s+(?:mi\s+h[aá]bito\s+de\s+|el\s+|la\s+)?(.+?)$',
  caseSensitive: false,
  multiLine: true,
);

/// Detecta creación de tarea: "necesito hacer X", "tengo que Y", "agregar tarea Z"
final _taskRegex = RegExp(
  r'(necesito\s+hacer|tengo\s+que|agregar?\s+tarea|crear?\s+tarea|recordarme?)'
  r'\s+(.+?)$',
  caseSensitive: false,
  multiLine: true,
);

/// Servicio de parsing de intents en texto libre para el agente de HeroOS.
///
/// Usa regex patterns para detectar intenciones sin necesidad de LLM,
/// y opcionalmente ejecuta la acción directamente via los repositorios.
///
/// Uso:
/// ```dart
/// final parser = AgentParserService(financeRepo, habitRepo);
/// final intents = await parser.detectIntents('gasté \$50 en comida');
/// ```
class AgentParserService {
  final IFinanceRepository _financeRepo;
  final IHabitRepository _habitRepo;

  AgentParserService({
    required IFinanceRepository financeRepository,
    required IHabitRepository habitRepository,
  }) : _financeRepo = financeRepository,
       _habitRepo = habitRepository;

  // ─── API pública ──────────────────────────────────────────────────────────

  /// Analiza [message] y retorna todos los intents detectados ordenados
  /// por confianza descendente.
  ///
  /// Si el mensaje no coincide con ningún patrón, retorna `[DetectedIntentModel.unknown()]`.
  List<DetectedIntentModel> detectIntents(String message) {
    final results = <DetectedIntentModel>[
      ...parseExpense(message),
      ...parseIncome(message),
      ...parseHabitCompletion(message),
      ...parseTaskCreation(message),
    ];

    if (results.isEmpty) return [DetectedIntentModel.unknown()];

    results.sort((a, b) => b.confidence.compareTo(a.confidence));
    return results;
  }

  /// Detecta y parsea intents de gasto en [message].
  List<DetectedIntentModel> parseExpense(String message) {
    final matches = _expenseRegex.allMatches(message.trim());
    return matches.map((m) => _buildExpenseIntent(m, message)).toList();
  }

  /// Detecta y parsea intents de ingreso en [message].
  List<DetectedIntentModel> parseIncome(String message) {
    final matches = _incomeRegex.allMatches(message.trim());
    return matches.map((m) => _buildIncomeIntent(m, message)).toList();
  }

  /// Detecta y parsea intents de completar hábito en [message].
  List<DetectedIntentModel> parseHabitCompletion(String message) {
    final matches = _habitRegex.allMatches(message.trim());
    return matches.map((m) => _buildHabitIntent(m, message)).toList();
  }

  /// Detecta y parsea intents de creación de tarea en [message].
  List<DetectedIntentModel> parseTaskCreation(String message) {
    final matches = _taskRegex.allMatches(message.trim());
    return matches.map((m) => _buildTaskIntent(m, message)).toList();
  }

  // ─── Ejecución de acciones ───────────────────────────────────────────────

  /// Ejecuta un [DetectedIntentModel] de tipo `financeExpense` o `financeIncome`.
  ///
  /// Requiere [userId] y [accountId] del usuario autenticado.
  /// Retorna `true` si la transacción fue creada correctamente.
  ///
  /// Lanza [ArgumentError] si el intent no es de tipo finance o falta `amount`.
  Future<bool> executeFinanceIntent(
    DetectedIntentModel intent, {
    required String userId,
    required String accountId,
  }) async {
    if (intent.intentType != IntentType.financeExpense &&
        intent.intentType != IntentType.financeIncome) {
      throw ArgumentError(
        'executeFinanceIntent: intent debe ser financeExpense o financeIncome, '
        'pero se recibió ${intent.intentType.toSnakeCase()}',
      );
    }

    final rawAmount = intent.extractedData['amount'];
    if (rawAmount == null) {
      throw ArgumentError(
        'executeFinanceIntent: falta "amount" en extractedData',
      );
    }

    final amount = (rawAmount as num).toDouble();
    final isExpense = intent.intentType == IntentType.financeExpense;
    final category = (intent.extractedData['category'] as String?) ?? 'General';
    final note = intent.extractedData['note'] as String?;

    final txn = TransactionEntity(
      id: '',
      userId: userId,
      accountId: accountId,
      amount: isExpense ? -amount.abs() : amount.abs(),
      category: category,
      note: note,
      date: DateTime.now(),
    );

    await _financeRepo.createTransaction(txn);
    return true;
  }

  /// Ejecuta un [DetectedIntentModel] de tipo `habitComplete`.
  ///
  /// Busca el hábito por nombre (case-insensitive, búsqueda parcial).
  /// Retorna el [HabitEntity] completado, o `null` si no se encontró.
  Future<HabitEntity?> executeHabitIntent(DetectedIntentModel intent) async {
    if (intent.intentType != IntentType.habitComplete) {
      throw ArgumentError(
        'executeHabitIntent: intent debe ser habitComplete, '
        'pero se recibió ${intent.intentType.toSnakeCase()}',
      );
    }

    final habitName = (intent.extractedData['habit_name'] as String?) ?? '';
    if (habitName.isEmpty) return null;

    final habits = await _habitRepo.getHabits();
    final today = DateTime.now();

    final match = _findHabitByName(habits, habitName, today);
    if (match == null) return null;

    await _habitRepo.logHabitCompletion(match.id, today);
    return match;
  }

  // ─── Builders privados ───────────────────────────────────────────────────

  DetectedIntentModel _buildExpenseIntent(RegExpMatch m, String original) {
    final verb = m.group(1) ?? '';
    final amountStr = (m.group(2) ?? '').replaceAll(',', '.');
    final category = _cleanCategory(m.group(3));

    final amount = double.tryParse(amountStr);
    if (amount == null) return DetectedIntentModel.unknown();

    // Confianza alta si hay verbo + monto + categoría
    final confidence = category != null ? 0.95 : 0.80;

    return DetectedIntentModel(
      intentType: IntentType.financeExpense,
      confidence: confidence,
      extractedData: {
        'amount': amount,
        'category': category ?? 'General',
        'note': 'Registrado por agente: $verb \$$amountStr',
      },
      matchedText: m.group(0) ?? original,
    );
  }

  DetectedIntentModel _buildIncomeIntent(RegExpMatch m, String original) {
    final verb = m.group(1) ?? '';
    final amountStr = (m.group(2) ?? '').replaceAll(',', '.');
    final source = _cleanCategory(m.group(3));

    final amount = double.tryParse(amountStr);
    if (amount == null) return DetectedIntentModel.unknown();

    final confidence = source != null ? 0.95 : 0.80;

    return DetectedIntentModel(
      intentType: IntentType.financeIncome,
      confidence: confidence,
      extractedData: {
        'amount': amount,
        'category': source ?? 'Ingresos',
        'note': 'Registrado por agente: $verb \$$amountStr',
      },
      matchedText: m.group(0) ?? original,
    );
  }

  DetectedIntentModel _buildHabitIntent(RegExpMatch m, String original) {
    final habitName = _cleanCategory(m.group(2)) ?? '';
    if (habitName.isEmpty) return DetectedIntentModel.unknown();

    return DetectedIntentModel(
      intentType: IntentType.habitComplete,
      confidence: 0.90,
      extractedData: {'habit_name': habitName},
      matchedText: m.group(0) ?? original,
    );
  }

  DetectedIntentModel _buildTaskIntent(RegExpMatch m, String original) {
    final title = _cleanCategory(m.group(2)) ?? '';
    if (title.isEmpty) return DetectedIntentModel.unknown();

    return DetectedIntentModel(
      intentType: IntentType.taskCreate,
      confidence: 0.85,
      extractedData: {'title': title},
      matchedText: m.group(0) ?? original,
    );
  }

  // ─── Helpers ─────────────────────────────────────────────────────────────

  /// Limpia y normaliza texto capturado (elimina puntuación sobrante).
  String? _cleanCategory(String? raw) {
    if (raw == null || raw.trim().isEmpty) return null;
    return raw.trim().replaceAll(RegExp(r'[.,;!?]+$'), '');
  }

  /// Busca el hábito activo más similar al [name] dado.
  /// Usa contains case-insensitive. Prioriza hábitos activos hoy.
  HabitEntity? _findHabitByName(
    List<HabitEntity> habits,
    String name,
    DateTime today,
  ) {
    final lower = name.toLowerCase();

    // Busca primero entre hábitos activos hoy
    final activeToday = habits.where(
      (h) => !h.isArchived && h.isActiveOn(today),
    );
    final matchToday = activeToday.where(
      (h) => h.title.toLowerCase().contains(lower),
    );
    if (matchToday.isNotEmpty) return matchToday.first;

    // Fallback: cualquier hábito no archivado
    final allActive = habits.where((h) => !h.isArchived);
    final matchAny = allActive.where(
      (h) => h.title.toLowerCase().contains(lower),
    );
    return matchAny.isNotEmpty ? matchAny.first : null;
  }
}
